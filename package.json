{
  "name": "shopping-ai-frontend",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/mockup-sandbox",
    "build": "npm run build --workspace=@workspace/mockup-sandbox && mkdir -p dist && cp -r artifacts/mockup-sandbox/dist/* ./dist/ 2>/dev/null || true",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
